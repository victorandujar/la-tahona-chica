---
import '../styles/global.css';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/fraunces/full.css';
import font from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import Seo from '../components/Seo.astro';
import { isDemo } from '../lib/site';
import { empresa } from '../data/empresa';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#28292c" />
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-carbon focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    {isDemo && (
      <aside aria-label="Aviso de demostración" class="fosc relative z-50 bg-carbon text-harina">
        <div class="mx-auto flex max-w-[84rem] flex-wrap items-center justify-center gap-x-5 gap-y-1.5 px-4 py-2 text-[0.72rem]">
          <p class="label text-[0.66rem] text-harina/85">Propuesta de diseño no oficial<span class="hidden sm:inline"> · Preparada por Ammavaroo para {empresa.name}</span></p>
          <div class="flex items-center gap-2" data-demo-carta>
            <span class="text-harina/70">Ver la carta:</span>
            <div class="flex overflow-hidden rounded-full border border-harina/30 font-semibold" role="group" aria-label="Estado de la carta en la demo">
              <button type="button" data-forzar="auto" class="px-2.5 py-1">Hoy</button>
              <button type="button" data-forzar="abierta" class="px-2.5 py-1">Abierta</button>
              <button type="button" data-forzar="cerrada" class="px-2.5 py-1">Cerrada</button>
            </div>
          </div>
        </div>
      </aside>
    )}
    <slot />
    <script>
      import '../scripts/reveal';
      import { guardarForzado, leerForzado, type Forzado } from '../scripts/ciclo';
      const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-forzar]')];
      const pinta = () => {
        const f = leerForzado();
        for (const b of btns) {
          const on = b.dataset.forzar === f;
          b.setAttribute('aria-pressed', String(on));
          b.classList.toggle('bg-trigo', on);
          b.classList.toggle('text-carbon', on);
        }
      };
      for (const b of btns) b.addEventListener('click', () => { guardarForzado((b.dataset.forzar ?? 'auto') as Forzado); });
      window.addEventListener('ltc:carta', pinta);
      pinta();
    </script>
  </body>
</html>
