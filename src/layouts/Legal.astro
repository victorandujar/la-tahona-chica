---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<Base title={`${title} · La Tahona Chica`} description={`${title} · La Tahona Chica`}>
  <Header panel />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-20 sm:px-8 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_p]:mt-4 [&_p]:text-gris">
    <h1 class="titol text-6xl">{title}</h1>
    <p class="rounded-xl bg-crema p-4 text-sm">Texto provisional de la propuesta, pendiente de revisión por el obrador.</p>
    <slot />
  </main>
  <Footer />
</Base>
