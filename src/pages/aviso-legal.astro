---
import Legal from '../layouts/Legal.astro';
import { empresa } from '../data/empresa';
---
<Legal title="Aviso legal">
  <h2>Titular del sitio web</h2>
  <p>{empresa.owner} ({empresa.name}) · NIF y domicilio: <mark>los del aviso legal actual</mark><br />{empresa.postalCode} {empresa.city} ({empresa.region}) · Teléfono: {empresa.phone.display} · Email: {empresa.email}</p>
  <h2>Propiedad intelectual</h2>
  <p>Las fotografías, los textos y el logotipo pertenecen a {empresa.name}.</p>
</Legal>
