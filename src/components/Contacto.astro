---
import { empresa, mailUrl, telUrl, waUrl } from '../data/empresa';
---
<section id="contacto" aria-labelledby="cont-t" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[84rem] gap-12 px-4 py-20 sm:px-8 sm:py-28 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <p class="label text-corteza" data-reveal>Contacto</p>
      <h2 id="cont-t" class="titol mt-4 text-[clamp(2.3rem,5vw,4.2rem)]" data-reveal style="--i:1">¿Alguna duda? <em>Escríbeme.</em></h2>
      <p class="mt-6 max-w-md text-lg text-gris" data-reveal style="--i:2">Estoy en {empresa.city} ({empresa.region}). No hay tienda: el pan se recoge los lunes por la mañana en el punto de entrega.</p>
    </div>
    <div class="grid content-start gap-3 lg:col-span-5 lg:col-start-8">
      <a href={waUrl('Hola, tengo una duda sobre el pan.')} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 rounded-2xl bg-carbon p-6 text-harina" data-reveal>
        <span><span class="label block text-harina/65">WhatsApp y teléfono</span><span class="titol mt-1 block text-3xl tabular-nums">{empresa.phone.display}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={mailUrl} class="group flex min-w-0 items-center justify-between gap-4 rounded-2xl border-2 border-crema-2 p-6 hover:border-carbon" data-reveal style="--i:1">
        <span class="min-w-0"><span class="label block text-gris">Email</span><span class="mt-1 block truncate text-xl font-semibold">{empresa.email}</span></span>
        <span aria-hidden="true" class="text-2xl">→</span>
      </a>
      <a href={empresa.instagram.url} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 rounded-2xl border-2 border-crema-2 p-6 hover:border-carbon" data-reveal style="--i:2">
        <span><span class="label block text-gris">Instagram</span><span class="mt-1 block text-xl font-semibold">{empresa.instagram.handle}</span></span>
        <span aria-hidden="true" class="text-2xl">↗</span>
      </a>
      <p class="mt-1 text-sm text-gris"><a href={telUrl} class="underline underline-offset-4">Llamar al {empresa.phone.display}</a></p>
    </div>
  </div>
</section>
