---
import { Image } from 'astro:assets';
import Estado from './Estado.astro';
import f1 from '../assets/fotos/f1.jpg';
import f3 from '../assets/fotos/f3.jpg';
import { empresa } from '../data/empresa';
---
<section class="paper overflow-x-clip" aria-labelledby="hero-t">
  <div class="mx-auto grid max-w-[84rem] gap-10 px-4 pb-16 pt-10 sm:px-8 sm:pb-24 sm:pt-14 lg:grid-cols-12 lg:gap-8">
    <div class="min-w-0 lg:col-span-7">
      <p class="label text-corteza">Micropanadería · {empresa.city} · {empresa.region}</p>
      <h1 id="hero-t" class="titol mt-5 text-[clamp(2.7rem,6.6vw,5.6rem)]">Pan de masa madre, hecho a mano y <em>bajo pedido.</em></h1>
      <p class="mt-6 max-w-xl text-lg text-gris">Harinas ecológicas, masa madre de cultivo propio y más de 24 horas de fermentación. Lo hago yo, pieza a pieza, y solo lo que me pedís.</p>
      <div class="mt-10 grid grid-cols-5 gap-3 sm:gap-4">
        <Image src={f3} alt="Hogazas recién horneadas de La Tahona Chica" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 34vw, 58vw" loading="eager" fetchpriority="high" class="col-span-3 aspect-[4/3] w-full rounded-2xl object-cover" />
        <Image src={f1} alt="Miga abierta de una hogaza de masa madre" widths={[300, 500, 700]} sizes="(min-width: 1024px) 22vw, 38vw" loading="eager" class="col-span-2 aspect-[8/9] w-full rounded-2xl object-cover" />
      </div>
    </div>
    <div class="min-w-0 lg:col-span-5 lg:pl-6 lg:pt-10">
      <Estado />
      <ul class="mt-6 grid gap-3 text-[0.98rem]">
        {['Harinas de agricultura ecológica', 'Sin levaduras industriales ni mejorantes', 'Producción limitada: se hornea lo pedido'].map((t) => (
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-corteza"></span>{t}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
