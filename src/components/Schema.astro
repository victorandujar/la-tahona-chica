---
import { empresa } from '../data/empresa';
import { productos } from '../data/productos';
interface Props { description: string }
const { description } = Astro.props;
const data = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: empresa.name,
  description,
  url: Astro.site?.href,
  telephone: empresa.phone.e164,
  email: empresa.email,
  address: { '@type': 'PostalAddress', postalCode: empresa.postalCode, addressLocality: empresa.city, addressRegion: empresa.region, addressCountry: 'ES' },
  sameAs: [empresa.instagram.url],
  hasOfferCatalog: {
    '@type': 'OfferCatalog', name: 'Carta',
    itemListElement: productos.map((p) => ({ '@type': 'Offer', price: (p.precio / 100).toFixed(2), priceCurrency: 'EUR', itemOffered: { '@type': 'Product', name: p.nombre } })),
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />
